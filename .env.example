# Domain shown in the card footer. Default: the host of the request.
SITE_DOMAIN=trackshare.example

# Optional. Without it, YouTube playlists and albums have no track count,
# and album playlists fall back to a 16:9 video thumbnail instead of a square cover.
# https://console.cloud.google.com → YouTube Data API v3 → API key.
YOUTUBE_API_KEY=

# Optional. Postgres connection string. When set, every card made and every
# download, copy and share is recorded, for popularity stats. Tables are created on first use.
# It also keys the hashed addresses that make each person count once a minute.
DATABASE_URL=
